{
  "name": "@influenceos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:integration": "dotenv -e ../../.env -- vitest run test/integration",
    "test:contract": "dotenv -e ../../.env -- vitest run test/contract.test.ts",
    "test:dod": "dotenv -e ../../.env -- vitest run test/dod.test.ts",
    "lint": "echo \"(api) no lint\"",
    "clean": "rm -rf node_modules .turbo dist"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.2",
    "@fastify/etag": "6.0.3",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/swagger": "9.4.2",
    "@fastify/swagger-ui": "5.2.2",
    "@influenceos/contracts": "workspace:*",
    "@influenceos/database": "workspace:*",
    "@influenceos/domain": "workspace:*",
    "@influenceos/shared": "workspace:*",
    "fastify": "5.2.1",
    "fastify-type-provider-zod": "4.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@node-rs/argon2": "2.0.2",
    "@types/node": "22.10.5",
    "dotenv-cli": "7.4.4",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
