{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "description": "", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }
  ],
  "title": "InfluenceOS — Overview",
  "uid": "influenceos-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["influenceos"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API up",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }], "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } },
      "targets": [{ "expr": "max(influenceos_up)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Database reachable",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "OK" } } }], "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } },
      "targets": [{ "expr": "max(influenceos_db_up)", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Build (git sha)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "options": { "reduceOptions": { "fields": "/^git_sha$/", "calcs": ["lastNotNull"] }, "textMode": "name" },
      "targets": [{ "expr": "influenceos_build_info", "refId": "A", "format": "table", "instant": true }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime (s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "max(process_uptime_seconds)", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by status class",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum by (status) (rate(influenceos_http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "5xx error ratio",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } },
      "targets": [{ "expr": "sum(rate(influenceos_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(influenceos_http_requests_total[5m])), 0.001)", "legendFormat": "5xx ratio", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API memory (RSS / heap used)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"influenceos-api\"}", "legendFormat": "rss", "refId": "A" },
        { "expr": "process_heap_used_bytes{job=\"influenceos-api\"}", "legendFormat": "heap used", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Top routes by request rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "topk(10, sum by (route) (rate(influenceos_http_requests_total[5m])))", "legendFormat": "{{route}}", "refId": "A" }]
    }
  ]
}
