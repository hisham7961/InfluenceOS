// InfluenceOS — PostgreSQL schema
// Strong, normalized relational model. JSON is used ONLY for raw provider
// metadata, provider capability details and optional platform-specific fields.
// See docs/DATABASE.md for the annotated model reference.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum UserRole {
  ADMIN
  STAFF
  VIEWER
}

/// Advanced Roles pass — an OPTIONAL refinement layered on top of the legacy
/// three-value UserRole, never a replacement (existing ADMIN/STAFF/VIEWER
/// checks throughout the codebase keep working unchanged). A user with no
/// roleProfile set falls back to a legacy-role default capability set, so
/// nothing narrows for existing users until an admin explicitly assigns one.
/// ADMIN/VIEWER profiles always pair with the matching legacy role; the other
/// four profiles are finer-grained shadings of STAFF, disambiguated by real
/// Capability grants + Country/Brand scope rather than the role string.
enum RoleProfile {
  ADMIN
  GENERAL_MANAGER
  OPERATIONS_MANAGER
  LOGISTICS
  INFLUENCER_MANAGER
  VIEWER
}

/// The capability vocabulary Role Profiles resolve to by default (see
/// packages/domain/src/lib/capabilities.ts) — authorization checks a
/// Capability, never a role string directly, so new operational profiles
/// never require scattering `actor.role === 'X'` checks through the app.
enum Capability {
  USERS_MANAGE
  ROLES_MANAGE
  BRANDS_VIEW
  BRANDS_MANAGE
  CAMPAIGNS_VIEW
  CAMPAIGNS_MANAGE
  INFLUENCERS_VIEW
  INFLUENCERS_MANAGE
  CONTENT_VIEW
  CONTENT_MANAGE
  UGC_REVIEW
  LOGISTICS_VIEW
  LOGISTICS_MANAGE
  LOGISTICS_ASSIGN
  LOGISTICS_ADDRESS_VIEW
  LOGISTICS_ADDRESS_EDIT
  LOGISTICS_ISSUE_MANAGE
  FINANCE_VIEW
  FINANCE_MANAGE
  REPORTS_VIEW
  OPERATIONS_VIEW
  SYSTEM_SETTINGS_MANAGE
  INTEGRATIONS_MANAGE
}

enum LogisticsIssueType {
  MISSING_ADDRESS
  INCOMPLETE_ADDRESS
  UNCLEAR_ADDRESS
  MISSING_PHONE
  INVALID_PHONE
  MISSING_AREA_CITY
  COUNTRY_MISMATCH
  LOCATION_CLARIFICATION
  OTHER
}

enum LogisticsIssueStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  SNAPCHAT
  X
}

/// Provenance of an externally-sourced value.
enum DataSource {
  MANUAL
  OFFICIAL_API
  EMBED
  UNAVAILABLE
}

enum RelationshipStatus {
  PROSPECT
  CONTACTED
  NEGOTIATING
  ACTIVE
  RECURRING
  PAST
  DECLINED
  BLACKLISTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ContactMethod {
  WHATSAPP
  EMAIL
  PHONE
  INSTAGRAM_DM
  OTHER
}

enum AudienceHealthLabel {
  HEALTHY
  REVIEW
  LIMITED_DATA
}

enum CampaignStatus {
  DRAFT
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignObjective {
  AWARENESS
  ENGAGEMENT
  CONVERSIONS
  LAUNCH
  UGC
  OTHER
}

enum DealType {
  FREE
  PAID
  GIFTED_PRODUCT
  PAID_PLUS_GIFTED
}

enum ParticipationStatus {
  INVITED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  DECLINED
  DROPPED
}

enum DeliverableType {
  POST
  STORY
  REEL
  SHORT
  VIDEO
  LIVE
  TWEET
  SNAP
  CAROUSEL
  UGC
  OTHER
}

enum DeliverableStatus {
  PLANNED
  SENT_TO_INFLUENCER
  AWAITING_PUBLICATION
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  VERIFIED
  MISSED
  CANCELLED
}

/// Review lifecycle of a single deliverable submission (draft) — W3-1.
enum SubmissionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

/// Availability / health state of a piece of published content.
enum ContentStatus {
  LIVE
  REMOVED
  PRIVATE
  UNAVAILABLE
  BROKEN_LINK
  UNKNOWN
}

enum PaymentStatus {
  NOT_APPLICABLE
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum ExpenseType {
  INFLUENCER_FEE
  GIFT_PRODUCT
  PRODUCTION
  ADS
  SHIPPING
  OTHER
}

enum NotificationCategory {
  CONTENT_REMOVED
  CONTENT_UNAVAILABLE
  DELIVERABLE_OVERDUE
  DELIVERABLE_DUE_SOON
  CAMPAIGN_ENDING
  SYNC_FAILURE
  NEW_CONTENT
  FOLLOWER_MILESTONE
  USAGE_RIGHT_EXPIRING
  /// A logistics fulfilment request reached DELIVERED (Content Command Center
  /// pass — gives What's New a real, distinguishable event instead of folding
  /// it into GENERAL).
  SHIPMENT_DELIVERED
  /// A UGC/draft submission was approved (Content Command Center pass).
  SUBMISSION_APPROVED
  /// Someone @mentioned this user in a comment/message (Operations
  /// Intelligence pass — Collaboration Layer).
  MENTION
  /// Someone replied to this user's message.
  REPLY
  /// A pinned/important message was posted somewhere this user should see
  /// (e.g. a Manager Callout on content they're associated with).
  IMPORTANT_MESSAGE
  /// A shipment's address/phone/location needs clarification from the
  /// responsible employee (Advanced Roles & Logistics Operations pass) —
  /// its own category so it's never confused with a routine shipment update.
  LOGISTICS_ADDRESS_ISSUE
  GENERAL
}

/// Category for a shared Trend/Inspiration item (Operations Intelligence
/// pass, PART 22) — deliberately a flat enum, not a second tagging system;
/// free-form `tags` on InspirationItem cover anything finer-grained.
enum InspirationCategory {
  TREND
  HOOK
  UGC_STYLE
  PRODUCT_DEMO
  BEFORE_AFTER
  EDUCATIONAL
  STORYTELLING
  VIRAL_FORMAT
  COMPETITOR
  AUDIO_TREND
  OTHER
}

enum InspirationStatus {
  ACTIVE
  ARCHIVED
}

/// What a usage right permits the brand to do with the content (W3-2).
enum UsageRightType {
  ORGANIC
  PAID_ADS
  WHITELISTING
  BROADCAST
  OTHER
}

enum UsageRightStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// Sourcing-pipeline stage for a creator considered for a campaign, BEFORE any
/// roster commit (W3-3). Evaluating candidates never creates a
/// CampaignInfluencer or touches relationship history — only CONVERTED does.
enum CandidateStatus {
  CONSIDERING
  SHORTLISTED
  APPROVED
  REJECTED
  CONVERTED
}

/// Fulfilment status of a product-seeding shipment (W3-5).
enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
  FAILED
}

enum ActivityType {
  BRAND_CREATED
  BRAND_UPDATED
  INFLUENCER_ADDED
  INFLUENCER_UPDATED
  SOCIAL_ACCOUNT_ADDED
  INFLUENCER_ADDED_TO_CAMPAIGN
  CAMPAIGN_CREATED
  CAMPAIGN_STATUS_CHANGED
  CAMPAIGN_UPDATED
  DELIVERABLE_ADDED
  DELIVERABLE_STATUS_CHANGED
  SCRIPT_ADDED
  SCRIPT_UPDATED
  CONTENT_PUBLISHED
  CONTENT_STATUS_CHANGED
  COST_ADDED
  COST_UPDATED
  NOTE_ADDED
  FOLLOWER_MILESTONE
  INFLUENCER_CONTACTED
  GENERIC
}

enum MonitoringEventType {
  CHECK_OK
  STATUS_CHANGED
  CHECK_FAILED
  RATE_LIMITED
}

enum IntegrationStatus {
  ENABLED
  DISABLED
  NOT_CONFIGURED
  ERROR
}

/// Client type for device sessions and feature targeting (mobile-readiness).
enum ClientType {
  WEB
  IOS
  ANDROID
  API
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum FeatureFlagScope {
  PLATFORM
  WEB
  MOBILE
  BRAND
}

enum MobilePlatform {
  IOS
  ANDROID
}

// ===========================================================================
// CORE
// ===========================================================================

model User {
  id                   String       @id @default(cuid())
  email                String       @unique
  name                 String
  passwordHash         String
  role                 UserRole     @default(STAFF)
  /// Advanced Roles pass — optional finer-grained profile layered on top of
  /// `role` (see the RoleProfile doc comment). Null = legacy behavior.
  roleProfile          RoleProfile?
  avatarUrl            String?
  locale               String       @default("en")
  theme                String       @default("system")
  isActive             Boolean      @default(true)
  lastLoginAt          DateTime?
  /// Preferred content discovery layout (Timeline/By Brand/Grid/Masonry/Feed) —
  /// same scalar-on-User preference pattern as locale/theme, not a new
  /// preferences architecture. Null = client default (Timeline).
  contentLayout        String?
  /// Per-user "What's New" checkpoint (Content Command Center pass). Advances
  /// only on an explicit ack from the client, never on lastLoginAt alone — a
  /// user can log in without ever opening Mission Control's What's New panel.
  lastWhatsNewViewedAt DateTime?
  // Time-boxed brute-force protection (in addition to the per-IP route limit):
  // consecutive failures raise the counter; crossing the threshold sets a short
  // lockout window; a successful login clears both.
  failedLoginAttempts  Int          @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  ownedCampaigns          Campaign[]               @relation("CampaignOwner")
  activities              ActivityLog[]            @relation("ActivityActor")
  notes                   Note[]
  scriptVersions          ScriptReferenceVersion[]
  reviewedScriptVersions  ScriptReferenceVersion[] @relation("ScriptVersionReviewer")
  attachments             Attachment[]
  expenses                CampaignExpense[]
  notifications           Notification[]
  savedViews              SavedView[]
  deviceSessions          DeviceSession[]
  submittedSubmissions    DeliverableSubmission[]  @relation("SubmissionSubmitter")
  reviewedSubmissions     DeliverableSubmission[]  @relation("SubmissionReviewer")
  submissionComments      SubmissionComment[]
  createdUsageRights      UsageRight[]
  addedCandidates         CampaignCandidate[]      @relation("CandidateAdder")
  decidedCandidates       CampaignCandidate[]      @relation("CandidateDecider")
  createdShipments        ProductShipment[]
  brandAccess             UserBrandAccess[]
  ownedInfluencers        Influencer[]             @relation("InfluencerOwner")
  contentStates           UserContentState[]
  noteMentions            NoteMention[]
  conversationReadStates  ConversationReadState[]
  submittedInspiration    InspirationItem[]
  capabilities            UserCapability[]
  countryAccess           UserCountryAccess[]
  assignedShipments       ProductShipment[]        @relation("ShipmentAssignee")
  createdLogisticsIssues  LogisticsIssue[]         @relation("LogisticsIssueCreator")
  assignedLogisticsIssues LogisticsIssue[]         @relation("LogisticsIssueAssignee")
  resolvedLogisticsIssues LogisticsIssue[]         @relation("LogisticsIssueResolver")

  @@index([role])
  @@index([roleProfile])
}

/// Explicit per-user capability override (Advanced Roles pass) — layered on
/// top of the Role Profile's default capability set. `granted: true` adds a
/// capability the profile doesn't include by default; `granted: false`
/// revokes one the profile WOULD include. Role Profiles stay the source of
/// sensible defaults; this table is the "explicit permissions if supported"
/// escape hatch, never the primary authorization path.
model UserCapability {
  id         String     @id @default(cuid())
  userId     String
  capability Capability
  granted    Boolean
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([userId])
}

/// Per-user country scope (Advanced Roles pass) — mirrors UserBrandAccess
/// exactly: a user WITH rows is limited to those countries, a user with NO
/// rows is unscoped (sees every country), and an ADMIN is always unscoped.
/// Independent of brand scope — a user's visible records must satisfy BOTH
/// where both apply. `countryCode` is a canonical ISO 3166-1 alpha-2 code
/// (see packages/shared/src/constants/countries.ts), never free text.
model UserCountryAccess {
  id          String   @id @default(cuid())
  userId      String
  countryCode String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, countryCode])
  @@index([userId])
  @@index([countryCode])
}

/// Per-user content review state (Content Command Center pass) — NEW/SEEN/
/// REVIEWED/REVIEW LATER are properties of the (user, content) pair, never of
/// PublishedContent itself: User A opening a video must never mark it seen
/// for User B. Absence of a row for a (userId, publishedContentId) pair IS the
/// "NEW" state — no row is ever created just to represent "new" (see
/// content-review-state.ts: NEW = derived from firstSeenAt == null / no row).
model UserContentState {
  id                 String    @id @default(cuid())
  userId             String
  publishedContentId String
  /// Set once, the first time the user opens this content's Viewer/detail —
  /// never overwritten afterward. Distinct from a passive card render.
  firstSeenAt        DateTime?
  /// Updated every time the user reopens it — a "last touched" timestamp.
  lastOpenedAt       DateTime?
  /// Set when the user explicitly presses "Mark Reviewed"; cleared (null) by
  /// "Mark Unreviewed". Never implies approved/published/verified — purely
  /// this user's own review checkbox.
  reviewedAt         DateTime?
  /// Set when the user explicitly saves this to their personal "Review Later"
  /// queue; cleared by "Remove from Review Later".
  savedForLaterAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishedContent PublishedContent @relation(fields: [publishedContentId], references: [id], onDelete: Cascade)

  @@unique([userId, publishedContentId])
  @@index([userId, reviewedAt])
  @@index([userId, savedForLaterAt])
  @@index([publishedContentId])
}

/// Per-user brand scope (W4-4). A user WITH one or more rows is limited to those
/// brands (least privilege); a user with NO rows is unscoped and sees every
/// brand (so existing users are unaffected). Admins are always unscoped.
model UserBrandAccess {
  id        String   @id @default(cuid())
  userId    String
  brandId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([userId])
  @@index([brandId])
}

model Brand {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  logoUrl        String?
  iconUrl        String?
  coverUrl       String?
  primaryColor   String   @default("#6366F1")
  accentColor    String?
  secondaryColor String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaigns        Campaign[]
  brandInfluencers BrandInfluencer[]
  publishedContent PublishedContent[]
  notes            Note[]
  notifications    Notification[]
  activities       ActivityLog[]
  usageRights      UsageRight[]
  userAccess       UserBrandAccess[]
  products         Product[]
  inspirationItems InspirationItem[]

  @@index([isActive])
  /// Trigram (pg_trgm) indexes behind the brand picker's fuzzy name search.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Brand_name_trgm_idx")
}

model Influencer {
  id                   String              @id @default(cuid())
  displayName          String
  fullName             String?
  primaryUsername      String?
  primaryPlatform      Platform?
  avatarOverrideUrl    String?
  resolvedAvatarUrl    String?
  bio                  String?
  country              String?
  /// Canonical ISO 3166-1 alpha-2 country code (Advanced Roles & Logistics
  /// Operations pass) — the creator's own profile/home-market country, kept
  /// deliberately separate from a shipment's destinationCountryCode: this is
  /// the source Country-scope enforcement and the Influencer directory's
  /// country filter read; `country` (free text) stays for legacy display and
  /// is never destroyed. Null until normalized (see the backfill migration).
  countryCode          String?
  city                 String?
  category             String?
  languages            String[]
  email                String?
  mobile               String?
  whatsapp             String?
  managerName          String?
  managerContact       String?
  preferredContact     ContactMethod?
  /// Relationship owner / assignee (W4-5): the staff member who owns this
  /// creator relationship. Reminders can be routed to them.
  ownerId              String?
  priority             Priority            @default(MEDIUM)
  relationshipStatus   RelationshipStatus  @default(PROSPECT)
  audienceHealth       AudienceHealthLabel @default(LIMITED_DATA)
  pricingNotes         String?
  internalNotes        String?
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  /// Shipping profile (Logistics): country/city/mobile/whatsapp above are
  /// reused as-is; these fill out a full postal address. A shipment always
  /// COPIES these into its own scalar columns at creation time rather than
  /// referencing the influencer live, so a later address change here never
  /// rewrites a past shipment's historical record.
  addressLine1         String?
  addressLine2         String?
  postalCode           String?
  deliveryInstructions String?

  owner               User?                @relation("InfluencerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  socialAccounts      SocialAccount[]
  brandInfluencers    BrandInfluencer[]
  campaignInfluencers CampaignInfluencer[]
  candidacies         CampaignCandidate[]
  creatorTokens       CreatorOAuthToken[]
  publishedContent    PublishedContent[]
  tags                InfluencerTag[]
  notes               Note[]
  attachments         Attachment[]
  activities          ActivityLog[]
  notifications       Notification[]
  usageRights         UsageRight[]

  @@index([relationshipStatus])
  @@index([ownerId])
  @@index([primaryPlatform])
  @@index([country])
  @@index([countryCode])
  @@index([category])
  @@index([isActive])
  // Cursor pagination order (createdAt desc, id desc) — W7-2/PERF-04.
  @@index([createdAt, id])
  // Final Completion Pass (FC-11): data-quality.service.ts's checkDuplicate()
  // does an exact-equality OR-branch lookup on each of these for every
  // "Add Influencer" duplicate check — previously unindexed, forcing a full
  // table scan per keystroke-ish call. email is looked up case-insensitively
  // (Prisma compiles `equals`+`mode:'insensitive'` to ILIKE, not `=`), so it
  // gets the trigram GIN index below instead of a plain btree — see this
  // migration's raw-SQL section (mirrors the W7-2 trigram precedent).
  @@index([mobile])
  @@index([whatsapp])
  /// Trigram (pg_trgm) indexes behind the directory's fuzzy name/handle search.
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Influencer_displayName_trgm_idx")
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Influencer_fullName_trgm_idx")
  @@index([primaryUsername(ops: raw("gin_trgm_ops"))], type: Gin, map: "Influencer_primaryUsername_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Influencer_email_trgm_idx")
}

model SocialAccount {
  id                String     @id @default(cuid())
  influencerId      String
  platform          Platform
  username          String
  profileUrl        String?
  platformUserId    String?
  displayName       String?
  avatarUrl         String?
  bio               String?
  followers         Int?
  following         Int?
  postCount         Int?
  isVerified        Boolean?
  isPrimary         Boolean    @default(false)
  dataSource        DataSource @default(MANUAL)
  lastSyncedAt      DateTime?
  /// Last time the worker tried to sync (success or not): failing accounts
  /// back off instead of being re-selected ahead of healthy ones every sweep.
  lastSyncAttemptAt DateTime?
  /// Why the last sync attempt failed; null after a successful sync.
  lastSyncError     String?
  rawMetadata       Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  influencer      Influencer             @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  metricSnapshots SocialMetricSnapshot[]

  @@unique([platform, username])
  @@index([influencerId])
  @@index([platform])
}

/// Periodic follower/growth snapshot. Historical values are NEVER overwritten.
model SocialMetricSnapshot {
  id              String     @id @default(cuid())
  socialAccountId String
  followers       Int?
  following       Int?
  postCount       Int?
  engagementRate  Float?
  capturedAt      DateTime   @default(now())
  source          DataSource @default(MANUAL)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, capturedAt])
}

/// Brand-specific relationship layer so one global influencer can work with
/// many brands without duplicating the influencer record.
model BrandInfluencer {
  id                   String             @id @default(cuid())
  brandId              String
  influencerId         String
  relationshipStatus   RelationshipStatus @default(PROSPECT)
  priority             Priority           @default(MEDIUM)
  internalNotes        String?
  defaultRate          Decimal?           @db.Decimal(18, 3)
  currency             String?
  firstCollaborationAt DateTime?
  lastCampaignAt       DateTime?
  totalCollaborations  Int                @default(0)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  brand      Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([brandId, influencerId])
  @@index([brandId])
  @@index([influencerId])
}

// ===========================================================================
// CAMPAIGNS
// ===========================================================================

model Campaign {
  id                   String             @id @default(cuid())
  brandId              String
  name                 String
  slug                 String
  coverUrl             String?
  description          String?
  brief                String?
  objective            CampaignObjective?
  status               CampaignStatus     @default(DRAFT)
  startDate            DateTime?
  endDate              DateTime?
  currency             String             @default("KWD")
  plannedBudget        Decimal?           @db.Decimal(18, 3)
  targetMarket         String?
  ownerId              String?
  internalNotes        String?
  /// Every deliverable goes through a draft review before posting (UGC always does).
  draftReview          Boolean            @default(false)
  /// What the brand was promised, shown against the results in the client report.
  targetViews          Int?
  targetEngagements    Int?
  /// Percent (e.g. 4.5).
  targetEngagementRate Float?
  targetCostPerView    Decimal?           @db.Decimal(18, 6)
  /// The agency's summary at the top of the client report.
  reportSummary        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  brand               Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  owner               User?                @relation("CampaignOwner", fields: [ownerId], references: [id])
  campaignInfluencers CampaignInfluencer[]
  candidates          CampaignCandidate[]
  scripts             ScriptReference[]
  publishedContent    PublishedContent[]
  expenses            CampaignExpense[]
  activities          ActivityLog[]
  notifications       Notification[]
  attachments         Attachment[]
  usageRights         UsageRight[]
  notes               Note[]
  inspirationItems    InspirationItem[]

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  // Cursor pagination order (createdAt desc, id desc) — W7-2/PERF-04.
  @@index([createdAt, id])
  /// Trigram (pg_trgm) indexes behind the campaign picker's fuzzy name search.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Campaign_name_trgm_idx")
}

model CampaignInfluencer {
  id                  String              @id @default(cuid())
  campaignId          String
  influencerId        String
  dealType            DealType            @default(PAID)
  agreedCost          Decimal?            @db.Decimal(18, 3)
  currency            String?
  giftedProductValue  Decimal?            @db.Decimal(18, 3)
  dateContacted       DateTime?
  expectedPublishAt   DateTime?
  participationStatus ParticipationStatus @default(INVITED)
  paymentStatus       PaymentStatus       @default(NOT_APPLICABLE)
  /// Amount of `agreedCost` actually paid — the source of truth for the
  /// paid/unpaid split when paymentStatus is PARTIALLY_PAID (finance P1).
  /// null = unknown; never coerced to 0.
  paidAmount          Decimal?            @db.Decimal(18, 3)
  paidAt              DateTime?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  campaign         Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer       Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  deliverables     Deliverable[]
  publishedContent PublishedContent[]
  expenses         CampaignExpense[]
  shipments        ProductShipment[]
  attachments      Attachment[]

  @@unique([campaignId, influencerId])
  @@index([campaignId])
  @@index([influencerId])
}

/// A small, deliberately minimal product catalog (W3-5 → Logistics evolution)
/// — just enough to give shipment line items real identity instead of a
/// free-text notes field, without turning InfluenceOS into inventory/ERP
/// software. Scoped per brand; resolved by findOrCreate-by-name so staff never
/// manage a separate "Products" admin screen.
model Product {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  createdAt DateTime @default(now())

  brand Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items ShipmentItem[]

  @@unique([brandId, name])
  @@index([brandId])
}

/// One product line item on a shipment: what, how many, optional SKU/variant.
/// This is what makes "TKN × 1, SPF × 2" a structured record instead of a
/// notes string.
model ShipmentItem {
  id         String  @id @default(cuid())
  shipmentId String
  productId  String
  sku        String?
  variant    String?
  quantity   Int     @default(1)

  shipment ProductShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([productId])
}

/// A logistics fulfilment request (evolved from the original W3-5
/// "one shipment per CampaignInfluencer" gift record). `campaignInfluencerId`
/// is NO LONGER unique — one CampaignInfluencer may need several independent
/// shipments (video 1's product, video 2's different product, a replacement
/// shipment), each optionally tied back to the specific Deliverable that
/// required it. Address/recipient fields are a point-in-time COPY (see the
/// doc comment on Influencer's shipping fields) — never a live reference.
model ProductShipment {
  id                     String         @id @default(cuid())
  campaignInfluencerId   String
  /// The specific deliverable this fulfils, if any — optional: a shipment can
  /// also be a general campaign-level gift not tied to one deliverable.
  deliverableId          String?
  recipientName          String?
  phone                  String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  country                String?
  /// Canonical ISO 3166-1 alpha-2 destination country (Advanced Roles &
  /// Logistics Operations pass) — a point-in-time snapshot, independent of
  /// the influencer's own countryCode: a Saudi creator can request delivery
  /// to a Dubai address, and this column is what "destination country"
  /// filtering/scoping reads, never derived live from the influencer.
  destinationCountryCode String?
  postalCode             String?
  deliveryInstructions   String?
  courier                String?
  trackingNumber         String?
  trackingUrl            String?
  status                 ShipmentStatus @default(PENDING)
  /// The logistics operator responsible for fulfilling this request —
  /// distinct from createdById (who requested it), the campaign owner, and
  /// the influencer relationship owner.
  assignedToUserId       String?
  shippedAt              DateTime?
  deliveredAt            DateTime?
  notes                  String?
  createdById            String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  campaignInfluencer CampaignInfluencer @relation(fields: [campaignInfluencerId], references: [id], onDelete: Cascade)
  deliverable        Deliverable?       @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  createdBy          User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo         User?              @relation("ShipmentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  items              ShipmentItem[]
  comments           Note[]
  issues             LogisticsIssue[]

  @@index([campaignInfluencerId])
  @@index([deliverableId])
  @@index([status])
  @@index([destinationCountryCode])
  @@index([assignedToUserId])
}

/// A reported problem blocking fulfilment of a shipment (Advanced Roles &
/// Logistics Operations pass) — deliberately NOT folded into ShipmentStatus
/// (a shipment can stay PENDING while carrying an OPEN issue) and
/// deliberately NOT a general-purpose issue tracker: scoped to exactly one
/// shipment, with a fixed type vocabulary. One issue record is read from
/// every surface that needs to show it (Logistics, Influencer 360, Campaign
/// Operations, Needs Attention) — never copied.
model LogisticsIssue {
  id               String               @id @default(cuid())
  shipmentId       String
  type             LogisticsIssueType
  status           LogisticsIssueStatus @default(OPEN)
  description      String
  createdById      String?
  assignedToUserId String?
  resolvedById     String?
  createdAt        DateTime             @default(now())
  resolvedAt       DateTime?

  shipment   ProductShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdBy  User?           @relation("LogisticsIssueCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?           @relation("LogisticsIssueAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedBy User?           @relation("LogisticsIssueResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([status])
  @@index([assignedToUserId])
}

/// A creator being sourced for a campaign — considered, shortlisted, approved
/// or rejected BEFORE any roster commit (W3-3). Staff can evaluate a large
/// candidate pool without inflating anyone's collaboration history; only
/// `convert` (→ CONVERTED) creates the CampaignInfluencer roster row.
model CampaignCandidate {
  id                            String          @id @default(cuid())
  campaignId                    String
  influencerId                  String
  status                        CandidateStatus @default(CONSIDERING)
  /// Optional staff fit score (0–100); null = unscored.
  fitScore                      Int?
  notes                         String?
  decisionReason                String?
  addedById                     String?
  decidedById                   String?
  decidedAt                     DateTime?
  /// Set once converted, linking back to the roster row that was created.
  convertedCampaignInfluencerId String?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  addedBy    User?      @relation("CandidateAdder", fields: [addedById], references: [id], onDelete: SetNull)
  decidedBy  User?      @relation("CandidateDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([campaignId, influencerId])
  @@index([campaignId])
  @@index([influencerId])
  @@index([status])
}

model Deliverable {
  id                   String            @id @default(cuid())
  campaignInfluencerId String
  platform             Platform
  type                 DeliverableType
  quantity             Int               @default(1)
  dueDate              DateTime?
  requirements         String?
  requiredHashtags     String[]
  requiredMentions     String[]
  scriptReferenceId    String?
  status               DeliverableStatus @default(PLANNED)
  publishedUrl         String?
  publishedAt          DateTime?
  internalNotes        String?
  /// Logistics: does completing this deliverable require shipping the
  /// creator a physical product? Drives the "Physical product required"
  /// toggle in the deliverable form and the operational warning when true
  /// but no shipment has been delivered yet as the due date approaches.
  requiresProduct      Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  campaignInfluencer CampaignInfluencer      @relation(fields: [campaignInfluencerId], references: [id], onDelete: Cascade)
  scriptReference    ScriptReference?        @relation(fields: [scriptReferenceId], references: [id])
  publishedContent   PublishedContent[]
  attachments        Attachment[]
  activities         ActivityLog[]
  submissions        DeliverableSubmission[]
  shipments          ProductShipment[]
  notes              Note[]

  @@index([campaignInfluencerId])
  @@index([status])
  @@index([dueDate])
  @@index([platform])
}

/// A creator's draft/asset submitted against a deliverable, moving through a
/// review lifecycle (W3-1). Successive versions are the revision rounds; an
/// APPROVED submission completes the deliverable — for a UGC deliverable this
/// happens without any public social URL.
model DeliverableSubmission {
  id            String           @id @default(cuid())
  deliverableId String
  version       Int              @default(1)
  status        SubmissionStatus @default(IN_REVIEW)
  notes         String?
  /// Link to the draft/owned asset (never a required public post).
  assetUrl      String?
  /// The caption the creator plans to post with it.
  caption       String?
  /// The draft file uploaded to the deliverable, if one was.
  attachmentId  String?
  submittedById String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  deliverable Deliverable         @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  attachment  Attachment?         @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  submittedBy User?               @relation("SubmissionSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?               @relation("SubmissionReviewer", fields: [reviewedById], references: [id])
  comments    SubmissionComment[]

  @@unique([deliverableId, version])
  @@index([deliverableId])
  @@index([status])
  @@index([attachmentId])
}

/// A threaded review comment on a submission (the review conversation).
model SubmissionComment {
  id           String   @id @default(cuid())
  submissionId String
  authorId     String?
  body         String
  createdAt    DateTime @default(now())

  submission DeliverableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User?                 @relation(fields: [authorId], references: [id])

  @@index([submissionId])
}

// ===========================================================================
// SCRIPTS & REFERENCES
// ===========================================================================

model ScriptReference {
  id              String   @id @default(cuid())
  campaignId      String?
  title           String
  currentVersion  Int      @default(1)
  /// The version the brand approved (the one creators should follow), if any.
  approvedVersion Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaign         Campaign?                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  versions         ScriptReferenceVersion[]
  deliverables     Deliverable[]
  attachments      Attachment[]
  inspirationItems InspirationItem[]

  @@index([campaignId])
}

enum ScriptVersionStatus {
  DRAFT
  SENT_TO_BRAND
  CHANGES_REQUESTED
  APPROVED
}

model ScriptReferenceVersion {
  id                String              @id @default(cuid())
  scriptReferenceId String
  version           Int
  body              String?
  captionSuggestion String?
  talkingPoints     String[]
  dos               String[]
  donts             String[]
  requiredClaims    String[]
  hashtags          String[]
  mentions          String[]
  referenceLinks    String[]
  internalComments  String?
  createdById       String?
  createdAt         DateTime            @default(now())
  /// Where this version is in the brand's approval: draft → sent to brand → approved (or changes requested).
  status            ScriptVersionStatus @default(DRAFT)
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?

  scriptReference ScriptReference @relation(fields: [scriptReferenceId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation(fields: [createdById], references: [id])
  reviewedBy      User?           @relation("ScriptVersionReviewer", fields: [reviewedById], references: [id])

  @@unique([scriptReferenceId, version])
  @@index([scriptReferenceId])
}

// ===========================================================================
// PUBLISHED CONTENT & METRICS
// ===========================================================================

model PublishedContent {
  id                   String        @id @default(cuid())
  platform             Platform
  externalId           String?
  originalUrl          String
  embedUrl             String?
  embedConfig          Json?
  thumbnailUrl         String?
  caption              String?
  publishedAt          DateTime?
  detectedAt           DateTime      @default(now())
  /// When the post went up, or when we found it if that's unknown — the
  /// one date lists sort by. Kept in step by a database trigger
  /// (migration 20260926170000); never written by the app.
  sortAt               DateTime      @default(now())
  brandId              String?
  campaignId           String?
  influencerId         String?
  campaignInfluencerId String?
  deliverableId        String?
  availabilityStatus   ContentStatus @default(UNKNOWN)
  lastCheckedAt        DateTime?
  nextCheckAt          DateTime?
  lastMetricsSyncAt    DateTime?
  checkFailureCount    Int           @default(0)
  dataSource           DataSource    @default(MANUAL)
  rawMetadata          Json?
  /// True for a Story screenshot/recording uploaded directly, never a link
  /// to a live post (Stories expire so there's nothing stable to link to).
  /// originalUrl is a synthetic, non-fetchable story://<uuid> placeholder in
  /// this case; the real media is the Attachment(s) targeting this row's id.
  /// Never enrolled in the availability-monitoring loop (nextCheckAt stays
  /// null) since there is no live URL to check.
  isStory              Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  brand              Brand?                   @relation(fields: [brandId], references: [id])
  campaign           Campaign?                @relation(fields: [campaignId], references: [id])
  influencer         Influencer?              @relation(fields: [influencerId], references: [id])
  campaignInfluencer CampaignInfluencer?      @relation(fields: [campaignInfluencerId], references: [id])
  deliverable        Deliverable?             @relation(fields: [deliverableId], references: [id])
  metricSnapshots    ContentMetricSnapshot[]
  monitoringEvents   ContentMonitoringEvent[]
  notifications      Notification[]
  activities         ActivityLog[]
  usageRights        UsageRight[]
  viewerStates       UserContentState[]
  notes              Note[]
  attachments        Attachment[]

  @@unique([platform, originalUrl])
  @@index([campaignId])
  @@index([brandId])
  @@index([influencerId])
  @@index([availabilityStatus])
  @@index([publishedAt])
  @@index([detectedAt])
  @@index([sortAt, id])
  @@index([platform, externalId])
  @@index([nextCheckAt])
}

/// Point-in-time content performance snapshot. NULL means "not available" for
/// that platform/metric — never a fabricated zero.
model ContentMetricSnapshot {
  id                 String     @id @default(cuid())
  publishedContentId String
  views              Int?
  likes              Int?
  comments           Int?
  shares             Int?
  reposts            Int?
  favorites          Int?
  saves              Int?
  engagement         Int?
  engagementRate     Float?
  capturedAt         DateTime   @default(now())
  source             DataSource @default(MANUAL)

  publishedContent PublishedContent @relation(fields: [publishedContentId], references: [id], onDelete: Cascade)

  @@index([publishedContentId, capturedAt])
}

model ContentMonitoringEvent {
  id                 String              @id @default(cuid())
  publishedContentId String
  type               MonitoringEventType
  fromStatus         ContentStatus?
  toStatus           ContentStatus?
  message            String?
  httpStatus         Int?
  success            Boolean             @default(true)
  checkedAt          DateTime            @default(now())

  publishedContent PublishedContent @relation(fields: [publishedContentId], references: [id], onDelete: Cascade)

  @@index([publishedContentId, checkedAt])
  @@index([type])
}

// ===========================================================================
// COSTS
// ===========================================================================

model CampaignExpense {
  id                   String        @id @default(cuid())
  campaignId           String
  campaignInfluencerId String?
  type                 ExpenseType
  label                String?
  amount               Decimal       @db.Decimal(18, 3)
  currency             String        @default("KWD")
  paymentStatus        PaymentStatus @default(UNPAID)
  /// Amount actually paid — source of truth for the paid/unpaid split when
  /// paymentStatus is PARTIALLY_PAID (finance P1). null = unknown.
  paidAmount           Decimal?      @db.Decimal(18, 3)
  paidAt               DateTime?
  incurredAt           DateTime?
  notes                String?
  createdById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignInfluencer CampaignInfluencer? @relation(fields: [campaignInfluencerId], references: [id])
  createdBy          User?               @relation(fields: [createdById], references: [id])

  @@index([campaignId])
  @@index([campaignInfluencerId])
}

// ===========================================================================
// SUPPORTING ENTITIES
// ===========================================================================

model Attachment {
  id                   String   @id @default(cuid())
  fileName             String
  mimeType             String
  sizeBytes            Int
  storageKey           String   @unique
  url                  String?
  kind                 String?
  influencerId         String?
  campaignId           String?
  deliverableId        String?
  scriptReferenceId    String?
  noteId               String?
  publishedContentId   String?
  /// A roster row's own files (the creator's agreement for that campaign).
  campaignInfluencerId String?
  uploadedById         String?
  createdAt            DateTime @default(now())

  campaign           Campaign?               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignInfluencer CampaignInfluencer?     @relation(fields: [campaignInfluencerId], references: [id], onDelete: Cascade)
  submissions        DeliverableSubmission[]
  influencer         Influencer?             @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  deliverable        Deliverable?            @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  scriptReference    ScriptReference?        @relation(fields: [scriptReferenceId], references: [id], onDelete: Cascade)
  note               Note?                   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  publishedContent   PublishedContent?       @relation(fields: [publishedContentId], references: [id], onDelete: Cascade)
  uploadedBy         User?                   @relation(fields: [uploadedById], references: [id])

  @@index([influencerId])
  @@index([campaignId])
  @@index([deliverableId])
  @@index([publishedContentId])
  @@index([campaignInfluencerId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  influencers InfluencerTag[]
}

model InfluencerTag {
  id           String @id @default(cuid())
  influencerId String
  tagId        String

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([influencerId, tagId])
  @@index([tagId])
}

/// The shared Collaboration Layer primitive (Operations Intelligence pass).
/// What started as a simple per-Influencer/Brand/Content "Note" is now the
/// ONE message/comment model reused for: contextual comments (Content,
/// Deliverable, Shipment, Campaign, Influencer), a Manager Callout (a
/// `pinned` content-context row), Campaign Chat (`campaignId` set, no other
/// context), General Team Chat (`channel` set, e.g. "general"), and
/// discussion on a Trend/Inspiration item. Exactly one of the context fields
/// (influencerId/brandId/publishedContentId/campaignId/deliverableId/
/// shipmentId/inspirationItemId/channel) is set per row — enforced in
/// collaboration.service.ts, mirroring the existing Attachment model's
/// one-nullable-FK-per-parent shape rather than a polymorphic pair. A reply
/// (`parentId` set) omits its own context — it inherits the parent's.
model Note {
  id                 String    @id @default(cuid())
  body               String
  influencerId       String?
  brandId            String?
  /// Notes attached to a piece of content (Content Command Center pass) —
  /// internal staff commentary ("Strong opening hook"), never written into
  /// the social caption itself. Also where a pinned Manager Callout lives.
  publishedContentId String?
  /// Campaign Chat when set with no other context — internal team
  /// discussion on a campaign, distinct from the campaign's ActivityLog.
  campaignId         String?
  /// Contextual comments on a single deliverable.
  deliverableId      String?
  /// Contextual comments on a logistics fulfilment request (relation name
  /// `comments` on ProductShipment — that model already has a scalar
  /// `notes String?` free-text field, so the back-relation can't reuse the
  /// name `notes`).
  shipmentId         String?
  /// Discussion on a Trends & Inspiration item (never written back into
  /// PublishedContent).
  inspirationItemId  String?
  /// Non-entity-scoped message — General Team Space channels (e.g.
  /// "general"). A free string, not an enum, so a later channel needs no
  /// schema change (PART 14: "later channels can be added if justified").
  channel            String?
  /// One level of replies only (enforced in the service layer — a reply
  /// whose parent itself has a parent is rejected rather than relied on
  /// being absent at the DB level).
  parentId           String?
  authorId           String?
  pinned             Boolean   @default(false)
  /// Set on a body edit so the UI can show an "edited" indicator.
  editedAt           DateTime?
  /// Soft delete for the NEW collaboration surfaces (comments with replies,
  /// chat, mentions) — physically deleting a message with live replies would
  /// orphan the thread, so authors/moderators "remove" it in place instead
  /// (the API blanks the returned body to "[deleted]" rather than exposing
  /// it). The original influencer/brand/content Note `remove()` endpoint is
  /// UNCHANGED and still hard-deletes — that simple personal-note use case
  /// predates threading/mentions and has no replies to orphan.
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  influencer       Influencer?       @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  brand            Brand?            @relation(fields: [brandId], references: [id])
  publishedContent PublishedContent? @relation(fields: [publishedContentId], references: [id], onDelete: Cascade)
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliverable      Deliverable?      @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  shipment         ProductShipment?  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  inspirationItem  InspirationItem?  @relation(fields: [inspirationItemId], references: [id], onDelete: Cascade)
  parent           Note?             @relation("NoteReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Note[]            @relation("NoteReplies")
  author           User?             @relation(fields: [authorId], references: [id])
  attachments      Attachment[]
  mentions         NoteMention[]

  @@index([influencerId])
  @@index([brandId])
  @@index([publishedContentId])
  @@index([campaignId])
  @@index([deliverableId])
  @@index([shipmentId])
  @@index([inspirationItemId])
  @@index([channel])
  @@index([parentId])
}

/// One row per user @mentioned in a Note/message — the efficient, indexed
/// query path behind "My Mentions" (a GIN-indexed userId array on Note would
/// also work, but a join table matches this schema's existing normalized
/// style, e.g. UserBrandAccess/UserContentState, and needs no special index
/// type).
model NoteMention {
  id        String   @id @default(cuid())
  noteId    String
  userId    String
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId, createdAt])
}

/// Per-user "last read" marker for a multi-party conversation (Campaign
/// Chat, General Team channels) — PART 16 explicitly asks for this shape
/// rather than a read row per message. `conversationKey` is a single string
/// discriminator (e.g. "campaign:<id>" or "channel:general") rather than two
/// nullable FK columns: Postgres does not treat two NULLs as equal for a
/// unique-constraint check, so a `[userId, campaignId, channel]` unique
/// index would silently admit duplicate rows whenever one side was null.
/// Not used for single-object comment threads (Content/Deliverable/
/// Shipment/Influencer/Trend) — those don't need an unread badge.
model ConversationReadState {
  id              String   @id @default(cuid())
  userId          String
  conversationKey String
  lastReadAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationKey])
}

/// A shared Trend/Inspiration item (PART 19-25) — external creative
/// reference material (a viral TikTok, a competitor's hook) the team wants
/// to discuss and reuse for ideas. Deliberately separate from
/// PublishedContent: this is NOT content we track as part of our own
/// creator/content operations, and must never pollute Live Content or
/// creator/campaign analytics. Only the URL/reference is stored — never a
/// re-hosted copy of someone else's video.
model InspirationItem {
  id                String              @id @default(cuid())
  url               String
  platform          Platform?
  thumbnailUrl      String?
  title             String?
  /// Why it's interesting, in the submitter's own words (PART 21).
  note              String?
  category          InspirationCategory @default(OTHER)
  tags              String[]
  brandId           String?
  campaignId        String?
  scriptReferenceId String?
  status            InspirationStatus   @default(ACTIVE)
  pinned            Boolean             @default(false)
  submittedById     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  campaign        Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  scriptReference ScriptReference? @relation(fields: [scriptReferenceId], references: [id], onDelete: SetNull)
  submittedBy     User?            @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  comments        Note[]

  @@index([brandId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

/// A usage-rights record (W3-2): what content a brand may use, in what way,
/// where, and until when. Expiry drives license-expiry alerts so ad spend never
/// runs on content whose rights have lapsed.
model UsageRight {
  id                    String           @id @default(cuid())
  brandId               String
  campaignId            String?
  influencerId          String?
  publishedContentId    String?
  usageType             UsageRightType   @default(ORGANIC)
  scope                 String?
  territory             String?
  exclusive             Boolean          @default(false)
  competitorRestriction String?
  disclosureRequired    Boolean          @default(false)
  startsAt              DateTime?
  expiresAt             DateTime?
  status                UsageRightStatus @default(ACTIVE)
  notes                 String?
  createdById           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  brand            Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  influencer       Influencer?       @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  publishedContent PublishedContent? @relation(fields: [publishedContentId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation(fields: [createdById], references: [id])

  @@index([brandId])
  @@index([campaignId])
  @@index([influencerId])
  @@index([expiresAt])
  @@index([status])
}

model Notification {
  id                 String               @id @default(cuid())
  category           NotificationCategory
  title              String
  body               String?
  targetUrl          String?
  isRead             Boolean              @default(false)
  readAt             DateTime?
  userId             String?
  brandId            String?
  influencerId       String?
  campaignId         String?
  publishedContentId String?
  createdAt          DateTime             @default(now())

  user             User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand            Brand?                 @relation(fields: [brandId], references: [id])
  influencer       Influencer?            @relation(fields: [influencerId], references: [id])
  campaign         Campaign?              @relation(fields: [campaignId], references: [id])
  publishedContent PublishedContent?      @relation(fields: [publishedContentId], references: [id])
  deliveries       NotificationDelivery[]

  @@index([userId])
  @@index([isRead, createdAt])
  @@index([category])
}

/// Independent delivery channel record so notification logic never needs to be
/// rewritten when PUSH/EMAIL are added for mobile (spec addendum §22). The
/// current product only produces IN_APP deliveries.
model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  channel        NotificationChannel        @default(IN_APP)
  status         NotificationDeliveryStatus @default(SENT)
  target         String?
  error          String?
  createdAt      DateTime                   @default(now())
  deliveredAt    DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel, status])
}

/// Mobile-safe auth: one record per authenticated client session (web cookie
/// session or a future device). Holds the hashed refresh token so refresh
/// tokens can rotate and sessions can be revoked server-side (addendum §20-21).
model DeviceSession {
  id                   String     @id @default(cuid())
  userId               String
  client               ClientType @default(WEB)
  deviceId             String?
  deviceName           String?
  appVersion           String?
  userAgent            String?
  ip                   String?
  refreshTokenHash     String
  /// Previous rotated refresh-token hash, honored only within a short grace
  /// window so genuinely concurrent refreshes don't false-positive as reuse.
  prevRefreshTokenHash String?
  /// When the current refresh token was last rotated (bounds the grace window).
  refreshRotatedAt     DateTime?
  /// AES-GCM-sealed copy of the current refresh token, kept only for the grace
  /// window so concurrent refreshes of the same token return the SAME rotated
  /// token (idempotent, race-free). Cleared once the grace window elapses.
  graceTokenSealed     String?
  pushToken            String?
  lastActiveAt         DateTime   @default(now())
  createdAt            DateTime   @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  /// Set when the session is force-revoked (e.g. refresh-token reuse detected).
  revokedReason        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
}

/// Central feature flag (addendum §18). Flags target the whole platform and/or
/// specific clients, and optionally a single brand. Resolved centrally.
model FeatureFlag {
  id          String           @id @default(cuid())
  key         String
  description String?
  scope       FeatureFlagScope @default(PLATFORM)
  enabled     Boolean          @default(true)
  brandId     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([key, scope, brandId])
  @@index([key])
}

/// Singleton server-owned client configuration surfaced to clients via
/// GET /api/v1/client-config (addendum §16). Never contains secrets.
model ClientConfig {
  id                 String   @id @default(cuid())
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  defaultLanguage    String   @default("en")
  supportedLanguages String[] @default(["en", "ar"])
  maxUploadMb        Int      @default(50)
  supportInfo        String?
  extra              Json?
  updatedAt          DateTime @updatedAt
}

/// Per-mobile-platform version rules (addendum §17). The mobile app is not
/// built now; this is the server-side capability it will later read.
model AppVersion {
  id                 String         @id @default(cuid())
  platform           MobilePlatform @unique
  recommendedVersion String?
  minimumVersion     String?
  storeUrl           String?
  forceUpdate        Boolean        @default(false)
  maintenanceMessage String?
  updatedAt          DateTime       @updatedAt
}

model ActivityLog {
  id                 String       @id @default(cuid())
  type               ActivityType
  message            String
  actorId            String?
  brandId            String?
  campaignId         String?
  influencerId       String?
  deliverableId      String?
  publishedContentId String?
  meta               Json?
  createdAt          DateTime     @default(now())

  actor            User?             @relation("ActivityActor", fields: [actorId], references: [id])
  brand            Brand?            @relation(fields: [brandId], references: [id])
  campaign         Campaign?         @relation(fields: [campaignId], references: [id])
  influencer       Influencer?       @relation(fields: [influencerId], references: [id])
  deliverable      Deliverable?      @relation(fields: [deliverableId], references: [id])
  publishedContent PublishedContent? @relation(fields: [publishedContentId], references: [id])
  // NOTE: the sibling `meta.shipmentId` JSONB-path filter is deliberately
  // NOT indexed here — Prisma's schema DSL cannot express the functional
  // (expression) btree index it needs. See this migration's raw-SQL section
  // for the index and the measured justification (EXPLAIN ANALYZE showed a
  // full-table scan even for a 3-row result once this table passed ~16.7k
  // rows).

  @@index([createdAt])
  @@index([brandId])
  @@index([campaignId])
  @@index([influencerId])
  @@index([type])
  // Final Completion Pass (FC-11): activity.service.ts's buildWhere() gained
  // a `publishedContentId` equality filter (a real column, unlike
  // `shipmentId` below) — mirrors the existing brandId/campaignId/
  // influencerId indexes on this same model exactly.
  @@index([publishedContentId])
}

/// Central provider integration state for the Admin Integrations screen and
/// observability. Capability details are stored as JSON (provider-specific).
/// One run of scripts/backup.sh — a database dump, a file mirror, or the weekly
/// restore test — recorded by the script itself (via psql in the postgres
/// container) so Settings → Platform can show when the last good backup ran.
model BackupRun {
  id         String   @id @default(cuid())
  /// database | files | restore-test
  kind       String
  ok         Boolean
  startedAt  DateTime
  finishedAt DateTime @default(now())
  sizeBytes  BigInt?
  /// Whether the copy also reached the off-server destination.
  offsite    Boolean  @default(false)
  message    String?

  @@index([kind, finishedAt])
}

model IntegrationSetting {
  id                String            @id @default(cuid())
  platform          Platform          @unique
  status            IntegrationStatus @default(NOT_CONFIGURED)
  isEnabled         Boolean           @default(true)
  monitoringEnabled Boolean           @default(true)
  capabilities      Json?
  config            Json?
  lastTestAt        DateTime?
  lastSuccessAt     DateTime?
  lastError         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

/// Opt-in encrypted store for provider API credentials entered from the admin
/// UI (INT-4). The value is sealed with AES-256-GCM (see domain/lib/crypto.ts,
/// keyed from AUTH_SECRET) so a raw DB dump never yields a usable key. When a
/// row exists it overrides the same-named environment variable at runtime; with
/// no rows the product stays purely env-driven (the default).
model ProviderCredential {
  id          String    @id @default(cuid())
  key         String    @unique
  platform    Platform?
  sealed      String
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Creator-OAuth token (INT-3): a creator's authorization for us to read their
/// OWN post metrics (Instagram media insights / TikTok video stats), which the
/// platforms do not expose to third parties otherwise. Tokens are sealed
/// (AES-256-GCM). One row per (influencer, platform). INERT until the platform
/// app passes review — the columns + flow exist, live fetch needs an approved app.
model CreatorOAuthToken {
  id                 String    @id @default(cuid())
  influencerId       String
  platform           Platform
  sealedAccessToken  String
  sealedRefreshToken String?
  externalUserId     String?
  scope              String?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([influencerId, platform])
  @@index([influencerId])
}

/// Future-proof: saved filters / views for directories and feeds.
model SavedView {
  id        String   @id @default(cuid())
  userId    String?
  scope     String
  name      String
  filters   Json
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([userId])
}
