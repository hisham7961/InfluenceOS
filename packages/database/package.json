{
  "name": "@influenceos/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./seed-data": "./src/seed-data.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:demo": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "bootstrap": "dotenv -e ../../.env -- tsx prisma/bootstrap.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(database) no lint\"",
    "clean": "rm -rf node_modules .turbo dist"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.3.1"
  },
  "devDependencies": {
    "@node-rs/argon2": "2.0.2",
    "dotenv-cli": "7.4.4",
    "prisma": "6.3.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
