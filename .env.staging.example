# ---------------------------------------------------------------------------
# InfluenceOS — STAGING environment template
#
# Staging mirrors the PRODUCTION architecture (proxy → web → api → postgres →
# redis → worker → private object storage) but is COMPLETELY SEPARATE from
# production: its own hostname, database, Redis, bucket, credentials, secrets,
# bootstrap admin, and provider credentials. NEVER point staging at production
# data or secrets.
#
# Copy to `.env.staging` (or inject via your secret manager) and replace every
# placeholder. NEVER commit the filled-in file.
#
# Staging runs PRODUCTION BUILDS (NODE_ENV=production) — not Next.js dev mode —
# so it validates the same code path that will ship. The API validates this
# contract at startup (apps/api/src/env.ts) and refuses to boot on a missing or
# weak mandatory value.
# ---------------------------------------------------------------------------

# Staging runs production builds. NODE_ENV MUST be production (enables secure
# cookies, strict secret checks, info logging). APP_ENV labels the deployment as
# staging on /health, /metrics, and Settings → Platform.
NODE_ENV=production
APP_ENV=staging

# --- Hostname (keep configurable) ------------------------------------------
# The public HTTPS URL of THIS staging environment. Expected pattern:
#   https://staging.influenceos.example.com
# Change to your real staging hostname. Must NOT be the production hostname.
NEXT_PUBLIC_APP_URL="https://staging.influenceos.example.com"
NEXT_PUBLIC_DEFAULT_LOCALE=en
WEB_ORIGIN="https://staging.influenceos.example.com"
# The reverse proxy reads this to obtain a certificate for the staging host.
SITE_ADDRESS="staging.influenceos.example.com"
# Browser-facing object-storage host (self-hosted MinIO behind the proxy). Must
# match the host in S3_PUBLIC_ENDPOINT below. Omit/ignore if using managed S3.
FILES_ADDRESS="staging-files.influenceos.example.com"
CADDY_ACME_EMAIL="staging-ops@example.com"

# --- Database — DEDICATED staging database ---------------------------------
# Use a database named for staging (e.g. influenceos_staging). NEVER reuse the
# production database name (influenceos_production) or a production host.
DATABASE_URL="postgresql://influenceos_staging:__STAGING_DB_PASSWORD__@postgres:5432/influenceos_staging?schema=public&sslmode=prefer"
DIRECT_DATABASE_URL="postgresql://influenceos_staging:__STAGING_DB_PASSWORD__@postgres:5432/influenceos_staging?schema=public&sslmode=prefer"
# Deploy scripts assert the target database name contains "staging" as a guard.

# --- Redis — DEDICATED staging instance/db ---------------------------------
# Separate Redis service (or at least a separate logical DB index). Do NOT share
# queue state with production. Require a password; keep it off the public net.
REDIS_URL="redis://:__STAGING_REDIS_PASSWORD__@redis:6379/0"

# --- Authentication — staging-only secret ----------------------------------
# REQUIRED >=32 chars, unique to staging (never the production secret).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="__GENERATE_A_STAGING_ONLY_64_CHAR_SECRET__"
AUTH_SESSION_TTL=604800
AUTH_REFRESH_GRACE_MS=30000
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15

# --- API / internal wiring -------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
INTERNAL_API_URL="http://api:4000"
LOG_LEVEL=info

# --- Object storage — DEDICATED staging bucket -----------------------------
# Use a staging bucket (e.g. influenceos-staging). Do NOT use the production
# bucket. Bucket stays PRIVATE; access is via signed URLs only.
STORAGE_DRIVER=s3
S3_INTERNAL_ENDPOINT="http://minio:9000"
S3_PUBLIC_ENDPOINT="https://staging-files.influenceos.example.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="__STAGING_S3_ACCESS_KEY__"
S3_SECRET_ACCESS_KEY="__STAGING_S3_SECRET_KEY__"
S3_BUCKET="influenceos-staging"
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=100

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW="1 minute"
RATE_LIMIT_REDIS=true

# --- Worker ----------------------------------------------------------------
WORKER_PORT=4100
# A brisk sweep on staging makes worker behaviour easy to observe/verify.
MONITOR_CRON="*/5 * * * *"
MONITOR_BATCH_SIZE=25

# --- First staging administrator (production-safe bootstrap) ---------------
# Used ONLY to create the first admin when the DB has no users (idempotent).
# No hardcoded password in source; supply a staging-only value here. The admin
# changes it afterwards via Settings → Security.
BOOTSTRAP_ADMIN_EMAIL="staging-admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="__STAGING_ADMIN_INITIAL_PASSWORD__"

# --- Release metadata (informational; injected by deploy; NEVER secrets) ---
APP_VERSION="staging"
GIT_SHA="__DEPLOYED_GIT_SHA__"
BUILD_TIME="__ISO8601_BUILD_TIMESTAMP__"

# --- Compose secrets (docker-compose.staging.yml) --------------------------
# The staging compose requires these (kept separate from production values).
POSTGRES_PASSWORD="__STAGING_DB_PASSWORD__"
POSTGRES_DB="influenceos_staging"
MINIO_ROOT_USER="__STAGING_S3_ACCESS_KEY__"
MINIO_ROOT_PASSWORD="__STAGING_S3_SECRET_KEY__"

# --- Backups (staging bucket, separate from production) --------------------
BACKUP_S3_BUCKET="influenceos-staging-backups"
BACKUP_S3_ENDPOINT="https://s3.example.com"
BACKUP_S3_ACCESS_KEY_ID="__STAGING_BACKUP_S3_ACCESS_KEY__"
BACKUP_S3_SECRET_ACCESS_KEY="__STAGING_BACKUP_S3_SECRET_KEY__"
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=2

# ---------------------------------------------------------------------------
# Social provider credentials (ALL OPTIONAL in staging).
# Leave blank to exercise MANUAL-FALLBACK behaviour. Use SEPARATE staging/sandbox
# credentials where a provider offers them — never production tokens.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=""
X_API_BEARER_TOKEN=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_ACCESS_TOKEN=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""
