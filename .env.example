# ---------------------------------------------------------------------------
# InfluenceOS — environment configuration (DEVELOPMENT)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# For a production deployment, start from `.env.production.example` instead.
#
# The API validates this contract at startup (apps/api/src/env.ts) and exits
# non-zero with a clear report if a mandatory value is missing or invalid.
# ---------------------------------------------------------------------------

# Node environment: development | production. Production enables stricter
# checks (AUTH_SECRET strength, secure cookies) and info-level logging.
NODE_ENV=development
# Deployment label surfaced on /health and Settings → Platform (informational):
# development | staging | production.
APP_ENV=development

# --- Database (PostgreSQL) -------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influenceos?schema=public"
# Direct (unpooled) connection used by Prisma Migrate. Usually the same in dev;
# in production point this at the primary (not a pgbouncer transaction pool).
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influenceos?schema=public"

# --- Redis (BullMQ queues; optional rate-limit store) ----------------------
REDIS_URL="redis://localhost:6379"

# --- Authentication --------------------------------------------------------
# Random secret used to sign session JWTs and derive the envelope-encryption
# key. Development accepts >=16 chars; PRODUCTION REQUIRES >=32 chars and a
# non-default value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-secret-value-please-rotate"
# Refresh-session lifetime in seconds (default 7 days).
AUTH_SESSION_TTL=604800
# Grace window (ms) during which the previous refresh token is still accepted
# after rotation, to tolerate concurrent refreshes. Default 30000.
AUTH_REFRESH_GRACE_MS=30000

# --- App / API wiring ------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Default locale (en | ar)
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Standalone API server
API_PORT=4000
API_HOST=0.0.0.0
# Origins allowed to call the API (comma separated) — the web client's origin.
WEB_ORIGIN="http://localhost:3000"
# Where the web server (SSR + BFF proxy) reaches the API internally.
INTERNAL_API_URL="http://localhost:4000"
# Log level override (trace|debug|info|warn|error). Defaults to warn in dev,
# info in production.
# LOG_LEVEL=info

# --- Object storage --------------------------------------------------------
# Driver: local (disk under /uploads) | s3 (S3/MinIO). Default local.
STORAGE_DRIVER=local
# When STORAGE_DRIVER=s3, the server uses S3_INTERNAL_ENDPOINT to reach the
# store and S3_PUBLIC_ENDPOINT to sign URLs the browser will use. In a simple
# setup both are the same; behind a private network they differ. S3_ENDPOINT is
# a legacy fallback for both.
S3_INTERNAL_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="influenceos"
S3_FORCE_PATH_STYLE=true
# Max upload size in MB (default 100).
MAX_UPLOAD_MB=100

# --- Rate limiting ---------------------------------------------------------
# Requests allowed per window per client. Defaults: 300 / "1 minute".
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW="1 minute"
# Set truthy to back the limiter with Redis (shared limit across API instances).
# Requires REDIS_URL. Leave unset for single-instance in-memory limiting.
# RATE_LIMIT_REDIS=true

# --- Content monitoring worker --------------------------------------------
WORKER_PORT=4100
# How often (cron) the availability monitor runs. Also configurable in DB.
MONITOR_CRON="*/30 * * * *"
# Max monitoring checks per provider per run (rate-limit safety)
MONITOR_BATCH_SIZE=25

# --- Release metadata (informational; NEVER secrets) -----------------------
# Injected at build/deploy time; surfaced on /health and Settings → Platform so
# an operator can confirm exactly which build is running.
# APP_VERSION=0.1.0
# GIT_SHA=""
# BUILD_TIME=""

# ---------------------------------------------------------------------------
# Social provider credentials (ALL OPTIONAL).
# The product works fully in manual-fallback mode without any of these.
# Adapters advertise reduced capabilities when a credential is missing.
# ---------------------------------------------------------------------------

# YouTube Data API v3 (public channel/video stats + oEmbed)
YOUTUBE_API_KEY=""

# X (Twitter) API v2 bearer token (+ oEmbed for embeds)
X_API_BEARER_TOKEN=""

# Meta / Instagram Graph API (Professional accounts only; oEmbed for embeds)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_ACCESS_TOKEN=""

# TikTok — display/embed only (no creator OAuth in this product)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Snapchat — manual/URL-based by default (no public profile API)
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""
