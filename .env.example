# ---------------------------------------------------------------------------
# InfluenceOS — environment configuration (DEVELOPMENT)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# For a production deployment, start from `.env.production.example` instead.
#
# The API validates this contract at startup (apps/api/src/env.ts) and exits
# non-zero with a clear report if a mandatory value is missing or invalid.
# ---------------------------------------------------------------------------

# Node environment: development | production. Production enables stricter
# checks (AUTH_SECRET strength, secure cookies) and info-level logging.
NODE_ENV=development
# Deployment label surfaced on /health and Settings → Platform (informational):
# development | staging | production.
APP_ENV=development

# --- Database (PostgreSQL) -------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influenceos?schema=public"
# Direct (unpooled) connection used by Prisma Migrate. Usually the same in dev;
# in production point this at the primary (not a pgbouncer transaction pool).
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influenceos?schema=public"

# --- Redis (BullMQ queues; optional rate-limit store) ----------------------
REDIS_URL="redis://localhost:6379"

# --- Authentication --------------------------------------------------------
# Random secret used to sign session JWTs and derive the envelope-encryption
# key. Development accepts >=16 chars; PRODUCTION REQUIRES >=32 chars and a
# non-default value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-secret-value-please-rotate"
# Refresh-session lifetime in seconds (default 7 days).
AUTH_SESSION_TTL=604800
# Grace window (ms) during which the previous refresh token is still accepted
# after rotation, to tolerate concurrent refreshes. Default 30000.
AUTH_REFRESH_GRACE_MS=30000
# Account-level brute-force protection (in addition to the per-IP login limit):
# consecutive failures before a short lockout, and the lockout length (minutes).
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15

# --- App / API wiring ------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Default locale (en | ar)
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Standalone API server
API_PORT=4000
API_HOST=0.0.0.0
# Origins allowed to call the API (comma separated) — the web client's origin.
WEB_ORIGIN="http://localhost:3000"
# Where the web server (SSR + BFF proxy) reaches the API internally.
INTERNAL_API_URL="http://localhost:4000"
# Log level override (trace|debug|info|warn|error). Defaults to warn in dev,
# info in production.
# LOG_LEVEL=info

# --- Object storage --------------------------------------------------------
# Driver: local (disk under /uploads) | s3 (S3/MinIO). Default local.
STORAGE_DRIVER=local
# When STORAGE_DRIVER=s3, the server uses S3_INTERNAL_ENDPOINT to reach the
# store and S3_PUBLIC_ENDPOINT to sign URLs the browser will use. In a simple
# setup both are the same; behind a private network they differ. S3_ENDPOINT is
# a legacy fallback for both.
S3_INTERNAL_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="influenceos"
S3_FORCE_PATH_STYLE=true
# Max upload size in MB (default 100).
MAX_UPLOAD_MB=100

# --- Object-storage container images (docker-compose) ----------------------
# MinIO Inc. archived the open-source MinIO/mc projects: quay.io and Docker
# Hub refuse anonymous pulls of minio/minio and minio/mc, and dl.min.io answers
# 410 for every community release. CI therefore builds MinIO + mc from the
# upstream release tags (docker/minio/) and publishes one image to GHCR. It is
# the same release the production server runs (RELEASE.2022-10-24, which works
# on a CPU without AVX and supports MINIO_API_CORS_ALLOW_ORIGIN), and it
# contains both `minio` and `mc`, so it serves MINIO_IMAGE and MINIO_MC_IMAGE.
# A host that already runs MinIO switches by setting both lines (data in the
# existing volume is untouched; the release is the same):
#   MINIO_IMAGE="ghcr.io/hisham7961/influenceos-minio:RELEASE.2022-10-24T18-35-07Z"
#   MINIO_MC_IMAGE="ghcr.io/hisham7961/influenceos-minio:RELEASE.2022-10-24T18-35-07Z"
# The host must be logged in to ghcr.io (the same login used for the app images).

# --- Rate limiting ---------------------------------------------------------
# Requests allowed per window per client. Defaults: 300 / "1 minute".
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW="1 minute"
# Set truthy to back the limiter with Redis (shared limit across API instances).
# Requires REDIS_URL. Leave unset for single-instance in-memory limiting.
# RATE_LIMIT_REDIS=true

# --- Content monitoring worker --------------------------------------------
WORKER_PORT=4100
# How often (cron) the availability monitor runs. Also configurable in DB.
MONITOR_CRON="*/30 * * * *"
# Content checks queued per sweep. When a backlog builds up the sweep queues
# more (up to MONITOR_MAX_BATCH_SIZE) so it drains instead of growing.
MONITOR_BATCH_SIZE=100
# MONITOR_MAX_BATCH_SIZE=400
# Follower-count syncs per sweep (Instagram allows ~200 API calls/hour per app).
# MONITOR_ACCOUNT_BATCH_SIZE=25

# --- Release metadata (informational; NEVER secrets) -----------------------
# Injected at build/deploy time; surfaced on /health and Settings → Platform so
# an operator can confirm exactly which build is running.
# APP_VERSION=0.1.0
# GIT_SHA=""
# BUILD_TIME=""

# ---------------------------------------------------------------------------
# Social provider credentials (ALL OPTIONAL).
# The product works fully in manual-fallback mode without any of these.
# Adapters advertise reduced capabilities when a credential is missing.
# ---------------------------------------------------------------------------

# YouTube Data API v3 (public channel/video stats + oEmbed)
YOUTUBE_API_KEY=""

# X (Twitter) API v2 bearer token (+ oEmbed for embeds)
X_API_BEARER_TOKEN=""

# Meta / Instagram Graph API (Professional accounts only; oEmbed for embeds).
# Profile lookup (Business Discovery) needs BOTH the access token AND the id of
# YOUR connected IG Business account — that account is the "self" node the
# lookup runs through. App id/secret are for the OAuth foundation (INT-3).
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# TikTok — display/embed only (no creator OAuth in this product)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Snapchat — manual/URL-based by default (no public profile API)
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""

# Creator-OAuth (INT-3) — the public base URL the platform redirects back to
# after a creator authorizes. The callback path is appended automatically:
#   <base>/api/v1/integrations/<platform>/oauth/callback
# Must exactly match the redirect URI registered in the Meta/TikTok app.
# Defaults to NEXT_PUBLIC_APP_URL when unset.
OAUTH_CALLBACK_BASE_URL=""

# --- Optional hardening (P2.4) ---------------------------------------------
# A separate key for stored secrets (provider API keys, creators' OAuth
# tokens). At least 32 characters. Without it they are sealed with a key
# derived from AUTH_SECRET. After adding it, run once:
#   pnpm --filter @influenceos/api run reseal
# ENCRYPTION_KEY=
# Worker dead-man's switch: pinged after every maintenance sweep (and at
# <url>/fail when one fails). E.g. a Healthchecks.io check URL.
# HEALTHCHECK_PING_URL=
# Interactive API docs (/api/docs, /api/openapi.json): off in production
# unless set to "on".
# API_DOCS=off

# --- Email (P2.6, optional) ------------------------------------------------
# The morning summary and the alerts people choose in Settings →
# Notifications. Without SMTP_URL nothing is emailed (notifications stay in
# the app). Use smtps:// (port 465) or smtp:// (587, upgraded with
# STARTTLS); URL-encode @ in the username as %40. Needed by the worker
# (sends) and the API ("Send me a test email").
# SMTP_URL=smtps://alerts%40your-domain.com:app-password@smtp.gmail.com:465
# MAIL_FROM="InfluenceOS <alerts@your-domain.com>"
# Address people open the app at, for links in emails (defaults to
# NEXT_PUBLIC_APP_URL).
# APP_URL=https://app.your-domain.com
