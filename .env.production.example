# ---------------------------------------------------------------------------
# InfluenceOS — PRODUCTION environment template
#
# Copy to `.env.production` (or inject via your secret manager / orchestrator)
# and replace EVERY placeholder. NEVER commit the filled-in file.
#
# The API validates this at startup (apps/api/src/env.ts) and REFUSES TO BOOT
# (exit 1, printed report) when a mandatory value is missing or a production
# rule is violated:
#   - AUTH_SECRET must be >= 32 chars and not contain "change-me"
#   - STORAGE_DRIVER=s3 requires endpoint + bucket + access key + secret
# Treat a failed boot as a configuration bug, not a transient error.
# ---------------------------------------------------------------------------

# MUST be exactly "production" in production: enables secure cookies, stricter
# secret checks, and info-level structured logging.
NODE_ENV=production
APP_ENV=production

# --- Database (PostgreSQL) -------------------------------------------------
# With docker-compose.full.yml these two are built by compose itself from
# POSTGRES_PASSWORD (user "postgres", host "postgres", db "influenceos") and
# the values here are ignored. Set them only for a database outside compose,
# ideally with TLS (sslmode=require). The runtime uses the pooled URL;
# migrations use the direct URL (never a transaction pooler).
POSTGRES_PASSWORD="__STRONG_DB_PASSWORD__"
DATABASE_URL="postgresql://postgres:__STRONG_DB_PASSWORD__@postgres:5432/influenceos?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:__STRONG_DB_PASSWORD__@postgres:5432/influenceos?schema=public"
# Least-privilege app logins (recommended). Set both of a pair and the next
# deploy makes the login and the app uses it: a database login that can only
# read and write rows (migrations keep the owner), and a MinIO login that can
# only use the app's bucket. Letters and digits only (they go into URLs):
#   openssl rand -hex 24
# Leave them unset to keep the owner/root logins.
# APP_DB_USER=influenceos_app
# APP_DB_PASSWORD=
# MINIO_APP_USER=influenceos-app
# MINIO_APP_PASSWORD=

# --- Redis -----------------------------------------------------------------
# Require a password in production (requirepass) and keep Redis off the public
# network. Used by the worker queues and, if enabled, the shared rate limiter.
REDIS_URL="redis://:__STRONG_REDIS_PASSWORD__@redis:6379"

# --- Authentication --------------------------------------------------------
# REQUIRED >= 32 chars, high-entropy, unique to this environment. Rotating this
# invalidates all sessions and re-keys envelope encryption — plan rotation.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="__GENERATE_A_64_CHAR_RANDOM_SECRET__"
AUTH_SESSION_TTL=604800
AUTH_REFRESH_GRACE_MS=30000
# Account-level brute-force lockout (defence in depth beyond the per-IP limit).
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15

# --- App / API wiring ------------------------------------------------------
# Public HTTPS URL of the platform (behind the reverse proxy).
NEXT_PUBLIC_APP_URL="https://influenceos.example.com"
NEXT_PUBLIC_DEFAULT_LOCALE=en
API_PORT=4000
# Bind to loopback/internal only; the reverse proxy is the only public listener.
API_HOST=0.0.0.0
# Exact browser origin(s) permitted by CORS — the public HTTPS origin, no trailing slash.
WEB_ORIGIN="https://influenceos.example.com"
# Internal address the web/SSR+BFF layer uses to reach the API (private network).
INTERNAL_API_URL="http://api:4000"
LOG_LEVEL=info

# --- Object storage (durable, private) -------------------------------------
# Use a real, backed-up object store (managed S3, or self-hosted MinIO with
# replication + backups). Buckets are PRIVATE; access is via signed URLs only.
STORAGE_DRIVER=s3
# Server-side endpoint (private network) and browser-facing endpoint (public).
S3_INTERNAL_ENDPOINT="http://minio:9000"
S3_PUBLIC_ENDPOINT="https://files.influenceos.example.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="__S3_ACCESS_KEY__"
S3_SECRET_ACCESS_KEY="__S3_SECRET_KEY__"
S3_BUCKET="influenceos"
S3_FORCE_PATH_STYLE=true
# Largest upload in MB (team files and creators' draft files). The compose
# default is 50; the reverse proxy takes up to 120 MB, so keep it at 110 or less.
MAX_UPLOAD_MB=100

# --- Rate limiting (Redis-backed for multi-instance) -----------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW="1 minute"
# Enable the shared Redis store so the limit is enforced across all API replicas.
RATE_LIMIT_REDIS=true

# --- Worker ----------------------------------------------------------------
WORKER_PORT=4100
MONITOR_CRON="*/30 * * * *"
# Content checks queued per sweep. When a backlog builds up the sweep queues
# more (up to MONITOR_MAX_BATCH_SIZE) so it drains instead of growing.
MONITOR_BATCH_SIZE=100
# MONITOR_MAX_BATCH_SIZE=400
# Follower-count syncs per sweep (Instagram allows ~200 API calls/hour per app).
# MONITOR_ACCOUNT_BATCH_SIZE=25
# Creator accounts read for new campaign posts per sweep (Instagram/YouTube/X with keys); 0 = off.
# MONITOR_DISCOVERY_BATCH_SIZE=20
# Post covers copied into our own storage per sweep (the platforms' links expire); 0 = off.
# COVER_BATCH_SIZE=30

# --- Release metadata (informational; injected by CI/deploy; NEVER secrets) -
APP_VERSION="1.0.0"
GIT_SHA="__DEPLOYED_GIT_SHA__"
BUILD_TIME="__ISO8601_BUILD_TIMESTAMP__"

# --- Backups (scripts/backup.sh — database + uploaded files) ---------------
# Run nightly from cron; see docs/BACKUP_AND_RESTORE.md §0. The off-server
# bucket should be a separate account/bucket from the app's own storage (any
# S3-compatible service: Backblaze B2, Cloudflare R2, AWS, Wasabi …).
BACKUP_DIR="/var/backups/influenceos"
BACKUP_S3_BUCKET="influenceos-backups"
BACKUP_S3_ENDPOINT="https://s3.example.com"
BACKUP_S3_PROVIDER="Other"
BACKUP_S3_ACCESS_KEY_ID="__BACKUP_S3_ACCESS_KEY__"
BACKUP_S3_SECRET_ACCESS_KEY="__BACKUP_S3_SECRET_KEY__"
# Encrypts everything before it leaves the server. Store a copy of this
# password somewhere else — without it the off-server backup can't be read.
BACKUP_ENCRYPTION_PASSWORD="__LONG_RANDOM_PASSPHRASE__"
# Optional dead-man switch (e.g. a Healthchecks.io check URL): alerts when a
# night's backup fails or doesn't run at all.
BACKUP_HEALTHCHECK_URL=""
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=6

# --- Orphaned-file cleanup (worker) -----------------------------------------
# Files no record points at are moved to quarantine/ and deleted after
# CLEANUP_QUARANTINE_DAYS. Switch it off while restoring a backup with the
# file_cleanup flag (Settings → Platform → Flags) or CLEANUP_ENABLED=false.
# CLEANUP_ENABLED=true
# CLEANUP_QUARANTINE_DAYS=30
# CLEANUP_MAX_ORPHANS=200

# ---------------------------------------------------------------------------
# Social provider credentials (ALL OPTIONAL). Store as secrets, not in the
# image. The product runs fully in manual-fallback mode without any of these.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=""
X_API_BEARER_TOKEN=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""

# --- Optional hardening (P2.4) ---------------------------------------------
# A separate key for stored secrets (provider API keys, creators' OAuth
# tokens). At least 32 characters. Without it they are sealed with a key
# derived from AUTH_SECRET. After adding it, run once:
#   pnpm --filter @influenceos/api run reseal
# ENCRYPTION_KEY=
# Worker dead-man's switch: pinged after every maintenance sweep (and at
# <url>/fail when one fails). E.g. a Healthchecks.io check URL.
# HEALTHCHECK_PING_URL=
# Interactive API docs (/api/docs, /api/openapi.json): off in production
# unless set to "on".
# API_DOCS=off

# --- Email (P2.6, optional) ------------------------------------------------
# The morning summary and the alerts people choose in Settings →
# Notifications. Without SMTP_URL nothing is emailed (notifications stay in
# the app). Use smtps:// (port 465) or smtp:// (587, upgraded with
# STARTTLS); URL-encode @ in the username as %40. Needed by the worker
# (sends) and the API ("Send me a test email").
# SMTP_URL=smtps://alerts%40your-domain.com:app-password@smtp.gmail.com:465
# MAIL_FROM="InfluenceOS <alerts@your-domain.com>"
# Address people open the app at, for links in emails (defaults to
# NEXT_PUBLIC_APP_URL).
# APP_URL=https://app.your-domain.com

# --- AI assistance (P3.2, optional) ------------------------------------------
# Off until an admin turns it on in Settings → AI, where the Claude API key
# (stored encrypted) and the model ID are normally entered. These only fill in
# what Settings leaves empty. Use the model ID exactly as your Anthropic
# account shows it; it must read images for screenshot reading.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=
