# ---------------------------------------------------------------------------
# InfluenceOS — PRODUCTION environment template
#
# Copy to `.env.production` (or inject via your secret manager / orchestrator)
# and replace EVERY placeholder. NEVER commit the filled-in file.
#
# The API validates this at startup (apps/api/src/env.ts) and REFUSES TO BOOT
# (exit 1, printed report) when a mandatory value is missing or a production
# rule is violated:
#   - AUTH_SECRET must be >= 32 chars and not contain "change-me"
#   - STORAGE_DRIVER=s3 requires endpoint + bucket + access key + secret
# Treat a failed boot as a configuration bug, not a transient error.
# ---------------------------------------------------------------------------

# MUST be exactly "production" in production: enables secure cookies, stricter
# secret checks, and info-level structured logging.
NODE_ENV=production
APP_ENV=production

# --- Database (PostgreSQL) -------------------------------------------------
# Use a strong password and, ideally, TLS (sslmode=require). The runtime uses
# the pooled URL; migrations use the direct URL (never a transaction pooler).
DATABASE_URL="postgresql://influenceos:__STRONG_DB_PASSWORD__@db:5432/influenceos?schema=public&sslmode=prefer"
DIRECT_DATABASE_URL="postgresql://influenceos:__STRONG_DB_PASSWORD__@db:5432/influenceos?schema=public&sslmode=prefer"

# --- Redis -----------------------------------------------------------------
# Require a password in production (requirepass) and keep Redis off the public
# network. Used by the worker queues and, if enabled, the shared rate limiter.
REDIS_URL="redis://:__STRONG_REDIS_PASSWORD__@redis:6379"

# --- Authentication --------------------------------------------------------
# REQUIRED >= 32 chars, high-entropy, unique to this environment. Rotating this
# invalidates all sessions and re-keys envelope encryption — plan rotation.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="__GENERATE_A_64_CHAR_RANDOM_SECRET__"
AUTH_SESSION_TTL=604800
AUTH_REFRESH_GRACE_MS=30000
# Account-level brute-force lockout (defence in depth beyond the per-IP limit).
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15

# --- App / API wiring ------------------------------------------------------
# Public HTTPS URL of the platform (behind the reverse proxy).
NEXT_PUBLIC_APP_URL="https://influenceos.example.com"
NEXT_PUBLIC_DEFAULT_LOCALE=en
API_PORT=4000
# Bind to loopback/internal only; the reverse proxy is the only public listener.
API_HOST=0.0.0.0
# Exact browser origin(s) permitted by CORS — the public HTTPS origin, no trailing slash.
WEB_ORIGIN="https://influenceos.example.com"
# Internal address the web/SSR+BFF layer uses to reach the API (private network).
INTERNAL_API_URL="http://api:4000"
LOG_LEVEL=info

# --- Object storage (durable, private) -------------------------------------
# Use a real, backed-up object store (managed S3, or self-hosted MinIO with
# replication + backups). Buckets are PRIVATE; access is via signed URLs only.
STORAGE_DRIVER=s3
# Server-side endpoint (private network) and browser-facing endpoint (public).
S3_INTERNAL_ENDPOINT="http://minio:9000"
S3_PUBLIC_ENDPOINT="https://files.influenceos.example.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="__S3_ACCESS_KEY__"
S3_SECRET_ACCESS_KEY="__S3_SECRET_KEY__"
S3_BUCKET="influenceos"
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=100

# --- Rate limiting (Redis-backed for multi-instance) -----------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW="1 minute"
# Enable the shared Redis store so the limit is enforced across all API replicas.
RATE_LIMIT_REDIS=true

# --- Worker ----------------------------------------------------------------
WORKER_PORT=4100
MONITOR_CRON="*/30 * * * *"
MONITOR_BATCH_SIZE=25

# --- Release metadata (informational; injected by CI/deploy; NEVER secrets) -
APP_VERSION="1.0.0"
GIT_SHA="__DEPLOYED_GIT_SHA__"
BUILD_TIME="__ISO8601_BUILD_TIMESTAMP__"

# --- Backups (used by scripts/backup-db.sh) --------------------------------
# Remote destination for off-host database backups (separate bucket/credentials
# from the app's object store is recommended). See docs/BACKUP_AND_RESTORE.md.
BACKUP_S3_BUCKET="influenceos-backups"
BACKUP_S3_ENDPOINT="https://s3.example.com"
BACKUP_S3_ACCESS_KEY_ID="__BACKUP_S3_ACCESS_KEY__"
BACKUP_S3_SECRET_ACCESS_KEY="__BACKUP_S3_SECRET_KEY__"
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=6

# ---------------------------------------------------------------------------
# Social provider credentials (ALL OPTIONAL). Store as secrets, not in the
# image. The product runs fully in manual-fallback mode without any of these.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=""
X_API_BEARER_TOKEN=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_ACCESS_TOKEN=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""
