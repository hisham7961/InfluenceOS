# InfluenceOS web — Next.js 15 client of the API (built, then `next start`).
# Build from the repo root:  docker build -f docker/Dockerfile.web -t influenceos-web .
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY . .
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @influenceos/database generate \
  && pnpm --filter @influenceos/web build

# Run as the unprivileged `node` user, not root.
RUN chown -R node:node /app /pnpm
USER node

ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "--filter", "@influenceos/web", "start"]
