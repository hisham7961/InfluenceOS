# InfluenceOS web — Next.js 15 client of the API (built, then `next start`).
# Build from the repo root:  docker build -f docker/Dockerfile.web -t influenceos-web .
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && mkdir -p /app /pnpm && chown node:node /app /pnpm
WORKDIR /app

# From here on everything runs as the unprivileged `node` user, and files are
# owned by it from the start. A recursive chown after the install used to copy
# the whole /app + node_modules tree into a second layer, doubling image size.
USER node
COPY --chown=node:node . .
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @influenceos/database generate \
  && pnpm --filter @influenceos/web build

ENV NODE_ENV=production
# Build identity, passed by CI and reported on /health and Settings → Platform.
# Kept under its own names: compose sets GIT_SHA/BUILD_TIME (often empty) at
# runtime, which would otherwise hide what the image was built from.
ARG GIT_SHA=unknown
ARG BUILD_TIME=
ENV BUILD_GIT_SHA=$GIT_SHA BUILD_BUILT_AT=$BUILD_TIME
EXPOSE 3000
CMD ["pnpm", "--filter", "@influenceos/web", "start"]
