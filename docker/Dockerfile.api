# InfluenceOS API — Fastify service (ships as TS source, run via tsx).
# Build from the repo root:  docker build -f docker/Dockerfile.api -t influenceos-api .
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

# Dependencies first for better layer caching, then the source.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY . .
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @influenceos/database generate

# Run as the unprivileged `node` user (present in the base image), not root.
RUN chown -R node:node /app /pnpm
USER node

ENV NODE_ENV=production
# Build identity, passed by CI and reported on /health and Settings → Platform.
# Kept under its own names: compose sets GIT_SHA/BUILD_TIME (often empty) at
# runtime, which would otherwise hide what the image was built from.
ARG GIT_SHA=unknown
ARG BUILD_TIME=
ENV BUILD_GIT_SHA=$GIT_SHA BUILD_BUILT_AT=$BUILD_TIME
EXPOSE 4000
# Env (DATABASE_URL, AUTH_SECRET, …) is provided by the container, not a .env file.
CMD ["pnpm", "--filter", "@influenceos/api", "exec", "tsx", "src/index.ts"]
